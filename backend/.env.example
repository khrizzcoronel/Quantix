# .env

# ==========================================
# CONFIGURACIÓN DEL SISTEMA
# ==========================================
PROJECT_NAME="Quantix API"
VERSION="1.0.0"

# ==========================================
# BASE DE DATOS (POSTGRESQL OLTP)
# ==========================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quantix_user
POSTGRES_PASSWORD=quantix_password
POSTGRES_DB=quantix_db

# ==========================================
# SEGURIDAD (JWT)
# ==========================================
# ¡CÁMBIAME EN PRODUCCIÓN! Generar una fuerte: openssl rand -hex 32
SECRET_KEY=change-me-use-a-random-value-of-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ==========================================
# NOTIFICACIONES (SMTP EMAIL)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@example.com
# Contraseña de aplicación generada (No la contraseña normal del correo)
SMTP_PASSWORD=your-app-password
